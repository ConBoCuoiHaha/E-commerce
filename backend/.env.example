# ============================================================
# FILE MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Copy thành ".env" rồi điền giá trị thật. File .env KHÔNG commit lên Git.
# ============================================================

PORT=5000
NODE_ENV=development

# Chuỗi kết nối MongoDB (local hoặc Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/hungsaigon_store

# Địa chỉ frontend được phép gọi API (CORS)
CLIENT_URL=http://localhost:5173

# --- Google OAuth (đăng nhập bằng Google) ---
# Client ID công khai, lấy ở console.cloud.google.com (OAuth client ID - Web).
# Để trống nếu không dùng đăng nhập Google (các tính năng khác vẫn chạy).
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# --- JWT: dùng 2 secret KHÁC NHAU cho access và refresh token ---
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=thay_bang_chuoi_ngau_nhien_dai_cho_access_token
JWT_REFRESH_SECRET=thay_bang_chuoi_ngau_nhien_dai_KHAC_cho_refresh_token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Email (Gmail SMTP) ---
# EMAIL_APP_PASSWORD là App Password 16 ký tự của Google (KHÔNG phải mật khẩu Gmail).
# Tạo tại: Google Account → Security → 2-Step Verification → App passwords
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=HungSaiGon <your_email@gmail.com>
